#наибольшая общая подпоследовательность
def lcs(A, B):
    F = [[0]*(len(B)+1) for _ in range(len(A)+1)]
    for i in range(1, len(A)+1):
        for j in range(1, len(B)+1):
            if A[i-1] == B[j-1]:
                F[i][j] = F[i-1][j-1] + 1
            else:
                F[i][j] = max(F[i-1][j], F[i][j-1])
    return F[-1][-1]
A = [0, 2, 1, 3]
B = [0, 1]
print(lcs(A, B))
#наибольшая возрастающая подпоследовательность
def lis(A):
    F = [0] * (len(A)+1)
    for i in range(1, len(A)+1):
        m = 0
        for j in range(0, i):
            if A[i-1] > A[j-1] and F[j] > m:
                m = F[j]
        F[i]= m + 1
    return F[len(A)]
print(lis(A))
#решение из просторов интернета - ФОКСВОРД
def lis_1(A):
    F = [0] * len(A)
    for i in range(len(A)):
        for j in range(i):
            if A[j] < A[i] and F[j] > F[i]:
                F[i] = F[j]
        F[i] += 1
    return F[-1]

print(lis_1(A))
#ее можно упростить
def gis(A):
    F = [0]*(len(A))
    for i in range(len(A)):
        for j in range(i):
            if A[j] < A[i] and F[j] > F[i]:
                F[i] = F[j]
        F[i] += 1
    return max(*F)
