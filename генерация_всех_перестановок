#генерация всех перестановок 1
def gen_bin(M, prefix=""):#для двоичной СС
    if M == 0:
        print(prefix)
    else:
        for digit in "0", "1":
            gen_bin(M - 1, prefix + digit)

def generate_number(N:int, M:int, prefix=None):
    """ Генерирует все числа (с лидирующими незначащими нулями)
        в N-ричной системе счиления (N <= 10)
        длины M
        """
    prefix = prefix or []
    if M == 0:
        print(prefix)
        return
    for digit in range(N):
        prefix.append(digit)
        generate_number(N, M - 1, prefix)
        prefix.pop()
generate_number(2, 2)
gen_bin(3)

def find(number, A):
    """Ищет x в A и возвращает True, если такой есть
       False, если такого нет
    """
    for x in A:
        if number == x:
            return True
    return False
