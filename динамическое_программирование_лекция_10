#динамическое программирование - лекция 10
#Асимптотика O(Fibn) через рекурсию
def fib (n):
    if n <= 1:
        return n
    return fib(n-1) + fib(n-2)
#Через динамическое программирование
def fib_2(n):
    fib = [0, 1] + [0] * (n - 1)
    for i in range(2, n + 1):
        fib[i] = fib[i - 1] + fib[i - 2]
    return fib[n]
#задача про кузнечика
def traj_num(N):
    k = [0, 1] + [0] * (N - 1)
    for i in range(2, N + 1):
        k[i] = k[i - 1] + k[i - 2]
    return k[N]
#задача про кузнечика с ограничениями
def count_trajectories(N, allowed:list):
    k = [0, 1, int(allowed[2])] + [0] * (N - 2)
    for i in range(3, N + 1):
        if allowed[1]:
            k[i] = k[i - 1] + k[i - 2] + k[i - 3]
    return k[N]
#задача - найти минимальную стоимость достижения клетки
def count_min_cost(N, price:list):
    C = [float('-inf'), price[1], price[1] + price[2]] + [0] * (N - 2)
    for i in range(3, N + 1):
        C[i] = price[i] + min(C[i - 1], C[i - 2])
    return C[N]
