#бинарный поиск в отсортированном массиве
def left_bound(A, key):
    left = -1
    right = len(A)
    while right - left > 1:
        middle = (right + left) // 2
        if A[middle] < key:
            left = middle
        else:
            right = middle
    return left
def right_bound(A, key):
    left = -1
    right = len(A)
    while right - left > 1:
        middle = (right + left) // 2
        if A[middle] <= key:
            left = middle
        else:
            right = middle
    return right
A = [1, 3, 3, 6, 7, 9]
key = 3
print(left_bound(A, key))
print(right_bound(A, key))
